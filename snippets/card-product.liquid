<article class="product-card"><a class="product-card-image" href="{{ card_product.url }}" aria-label="{{ card_product.title | escape }}">{% if card_product.featured_image %}{{ card_product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '250,400,550,700', alt: card_product.featured_image.alt | default: card_product.title }}{% else %}<div class="image-placeholder">Product image coming soon</div>{% endif %}{% unless card_product.available %}<span class="product-card-badge">Sold out</span>{% endunless %}</a><div class="product-card-info"><h3><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3>{% render 'price', product: card_product %}{% if card_product.description != blank %}<p>{{ card_product.description | strip_html | truncate: 90 }}</p>{% endif %}<a class="text-link" href="{{ card_product.url }}">View product →</a></div></article>