{% liquid
  assign price_product = product
  if use_variant
    assign price_value = price_product.selected_or_first_available_variant.price
    assign compare_value = price_product.selected_or_first_available_variant.compare_at_price
  else
    assign price_value = price_product.price
    assign compare_value = price_product.compare_at_price
  endif
%}<div class="price">{% if compare_value > price_value %}<span class="visually-hidden">Sale price</span><span class="price-current">{{ price_value | money }}</span><s class="price-compare">{{ compare_value | money }}</s><span class="sale-badge">Sale</span>{% else %}<span class="price-current">{{ price_value | money }}</span>{% endif %}</div>