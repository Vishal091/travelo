<section class="section-space faq-section" id="faq"><div class="page-width faq-layout">
  <div class="section-heading">
    {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h2>{{ section.settings.heading | escape }}</h2>
    {% if section.settings.intro != blank %}<div class="section-intro rte">{{ section.settings.intro }}</div>{% endif %}
  </div>
  <div class="faq-list">
    {% for block in section.blocks %}
      <details class="faq-item" {{ block.shopify_attributes }} {% if forloop.first and section.settings.open_first %}open{% endif %}>
        <summary>{{ block.settings.question | escape }}<span class="faq-plus" aria-hidden="true">+</span></summary>
        <div class="faq-answer rte">{{ block.settings.answer }}</div>
      </details>
    {% endfor %}
  </div>
  <div class="faq-policy-links">
    <span>Need more detail?</span>
    <a href="/policies/shipping-policy">Shipping policy</a>
    <a href="/policies/refund-policy">Returns & refunds</a>
    <a href="/pages/contact">Contact us</a>
  </div>
</div></section>
{% schema %}
{"name":"FAQs","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Good to know"},{"type":"text","id":"heading","label":"Heading","default":"Questions, answered."},{"type":"richtext","id":"intro","label":"Intro","default":"<p>Clear information helps you choose with confidence. Review product compatibility and the store policies before ordering.</p>"},{"type":"checkbox","id":"open_first","label":"Open first question by default","default":false}],"blocks":[{"type":"faq","name":"Question and answer","settings":[{"type":"text","id":"question","label":"Question","default":"Will this fit every shower drain?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Not necessarily. Drain shapes and dimensions vary. Please check the product dimensions and compatibility details before ordering.</p>"}]}],"max_blocks":12,"presets":[{"name":"FAQs","blocks":[{"type":"faq","settings":{"question":"Will this fit every shower drain?","answer":"<p>Not necessarily. Drain shapes and dimensions vary. Check the product dimensions and compatibility details before ordering.</p>"}},{"type":"faq","settings":{"question":"How do I clean the catcher?","answer":"<p>Remove collected hair and rinse the item according to the final product care instructions.</p>"}},{"type":"faq","settings":{"question":"Does it prevent every clog?","answer":"<p>No. It is designed to help collect loose hair, but it cannot prevent every blockage or replace routine drain maintenance.</p>"}},{"type":"faq","settings":{"question":"How long does delivery take?","answer":"<p>Delivery estimates depend on destination and fulfilment route. Please check the Shipping Policy and the estimate shown at checkout before placing your order.</p>"}},{"type":"faq","settings":{"question":"How do returns work?","answer":"<p>Please review the Returns & Refunds Policy and contact us before sending an item back.</p>"}}]}]}
{% endschema %}