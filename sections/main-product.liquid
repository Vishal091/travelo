{% assign current_variant = product.selected_or_first_available_variant %}<section class="section-space main-product-section"><div class="page-width product-layout"><div class="product-gallery">{% if product.media.size > 0 %}{% for media in product.media %}<div class="product-gallery-item">{% if media.media_type == 'image' %}{{ media | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400,700,1000,1400', alt: media.alt | default: product.title }}{% else %}{{ media | media_tag }}{% endif %}</div>{% endfor %}{% else %}<div class="image-placeholder">Add real product photos in Shopify Admin</div>{% endif %}</div><div class="product-info">{% if section.settings.show_vendor and product.vendor != blank %}<p class="eyebrow">{{ product.vendor | escape }}</p>{% endif %}<h1 class="product-title">{{ product.title | escape }}</h1><div class="product-price" id="ProductPrice-{{ section.id }}">{% render 'price', product: product, use_variant: true %}</div>{% if section.settings.show_sku and current_variant.sku != blank %}<p class="product-sku">SKU: {{ current_variant.sku | escape }}</p>{% endif %}{% if section.settings.show_description %}{% if section.settings.product_blurb != blank %}<p class="product-description">{{ section.settings.product_blurb | escape }}</p>{% else %}<div class="rte product-description">{{ product.description }}</div>{% endif %}{% endif %}
{% form 'product', product, id: 'ProductForm', class: 'product-form' %}{% unless product.has_only_default_variant %}<label for="VariantSelect-{{ section.id }}">Choose an option</label><select id="VariantSelect-{{ section.id }}" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == current_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} · Sold out{% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ current_variant.id }}">{% endunless %}<label for="Quantity-{{ section.id }}">Quantity</label><input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1" inputmode="numeric"><button class="button button-primary button-full" type="submit" name="add" {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}</button>{{ form | payment_button }}{% endform %}<p class="fine-print">Shipping and taxes are calculated at checkout where applicable. Review the store's shipping and return policies before ordering.</p>{% if section.settings.show_share %}<a class="text-link" href="{{ product.url | prepend: shop.url }}">Share product link</a>{% endif %}</div></div></section>
{% schema %}{"name":"Main product","settings":[{"type":"checkbox","id":"show_vendor","label":"Show vendor","default":false},{"type":"checkbox","id":"show_sku","label":"Show SKU","default":false},{"type":"checkbox","id":"show_description","label":"Show description","default":true},{"type":"textarea","id":"product_blurb","label":"Short product description","default":"Helps collect loose hair near compatible drains. Check your drain shape and measurements before ordering."},{"type":"checkbox","id":"show_share","label":"Show product URL","default":false}]}{% endschema %}