<footer class="site-footer" id="site-footer">
  <div class="page-width footer-grid">
    <div class="footer-brand-column">
      <a class="footer-brand" href="{{ routes.root_url }}">{{ settings.brand_name | default: shop.name | escape }}</a>
      <p class="footer-copy">{{ section.settings.blurb | escape }}</p>
    </div>
    <div class="footer-link-columns">
      <div class="footer-links"><span class="footer-links-heading">Help</span><a href="{{ routes.all_products_collection_url }}">Shop all</a><a href="{{ routes.root_url }}#faq">FAQs</a><a href="/pages/contact">Contact us</a></div>
      <div class="footer-links"><span class="footer-links-heading">Policies</span><a href="/policies/shipping-policy">Shipping policy</a><a href="/policies/refund-policy">Returns & refunds</a><a href="/policies/privacy-policy">Privacy policy</a><a href="/policies/terms-of-service">Terms of service</a></div>
    </div>
  </div>
  <div class="page-width footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ settings.brand_name | default: shop.name | escape }}</span><span>{{ powered_by_link }}</span></div>
</footer>
{% schema %}{"name":"Footer","settings":[{"type":"textarea","id":"blurb","label":"Brand description","default":"Thoughtful tools for the little tasks that make a home feel easier."}]}{% endschema %}