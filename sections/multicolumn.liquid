<section class="section-space multicolumn-section" id="how-it-works"><div class="page-width"><div class="section-heading">{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.text != blank %}<div class="section-intro rte">{{ section.settings.text }}</div>{% endif %}</div><div class="columns-grid">{% for block in section.blocks %}<article class="column-card" {{ block.shopify_attributes }}><span class="column-number">0{{ forloop.index }}</span>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200,300,450,600', alt: block.settings.heading }}{% else %}<div class="column-symbol" aria-hidden="true">{% case forloop.index %}{% when 1 %}⌂{% when 2 %}↻{% else %}✳{% endcase %}</div>{% endif %}<h3>{{ block.settings.heading | escape }}</h3><div class="rte">{{ block.settings.text }}</div></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Multicolumn","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Keep it simple"},{"type":"text","id":"heading","label":"Heading","default":"Thoughtful tools. Everyday usefulness."},{"type":"richtext","id":"text","label":"Intro text","default":"<p>Small, practical products for the routines you already have.</p>"}],"blocks":[{"type":"column","name":"Column","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"heading","label":"Heading","default":"Designed for daily life"},{"type":"richtext","id":"text","label":"Text","default":"<p>Simple details that make everyday routines easier.</p>"}]}],"max_blocks":4,"presets":[{"name":"Multicolumn","blocks":[{"type":"column"},{"type":"column"},{"type":"column"}]}]}{% endschema %}