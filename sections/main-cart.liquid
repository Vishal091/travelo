<section class="section-space cart-section"><div class="page-width"><h1>Your cart</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post" novalidate><div class="cart-lines">{% for item in cart.items %}<div class="cart-line"><a class="cart-line-image" href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title }}{% endif %}</a><div class="cart-line-info"><a href="{{ item.url }}"><strong>{{ item.product.title | escape }}</strong></a>{% unless item.variant.title == 'Default Title' %}<p>{{ item.variant.title | escape }}</p>{% endunless %}<p>{{ item.final_price | money }}</p><label for="Quantity-{{ item.key }}">Quantity</label><input id="Quantity-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric"><a class="text-link" href="{{ item.url_to_remove }}">Remove</a></div><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}</div><div class="cart-summary"><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><p class="fine-print">Shipping, discounts and taxes are calculated at checkout where applicable.</p><button class="button button-secondary" type="submit" name="update">Update cart</button><button class="button button-primary" type="submit" name="checkout">Proceed to checkout</button></div></form>{% else %}<div class="empty-cart"><p>Your bag is currently empty.</p><a class="button button-primary" href="{{ routes.all_products_collection_url }}">Explore the shop</a></div>{% endif %}</div></section>
{% schema %}{"name":"Main cart","settings":[]}{% endschema %}