<section class="section-space newsletter-section"><div class="page-width newsletter-inner">
  {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
  <h2>{{ section.settings.heading | escape }}</h2>
  <div class="newsletter-copy rte">{{ section.settings.text }}</div>
  {% form 'customer', class: 'newsletter-form' %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    {% if form.posted_successfully? %}
      <p class="form-success" role="status">{{ section.settings.success_text | escape }}</p>
    {% else %}
      {% if form.errors %}<div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">Email address</label>
      <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email | escape }}" placeholder="Your email address" autocorrect="off" autocapitalize="off" autocomplete="email" required>
      <label class="newsletter-consent" for="NewsletterConsent-{{ section.id }}"><input id="NewsletterConsent-{{ section.id }}" type="checkbox" name="contact[accepts_marketing]" value="true" required><span>I agree to receive marketing emails and understand I can unsubscribe at any time.</span></label>
      <button class="button button-primary" type="submit">{{ section.settings.button_label | escape }}</button>
    {% endif %}
  {% endform %}
  <p class="newsletter-privacy">{{ section.settings.disclaimer | escape }} <a href="/policies/privacy-policy">Privacy policy</a>.</p>
</div></section>
{% schema %}
{"name":"Newsletter signup","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The occasional useful note"},{"type":"text","id":"heading","label":"Heading","default":"Make room for easier routines."},{"type":"richtext","id":"text","label":"Text","default":"<p>Sign up for product updates and practical home tips.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Sign me up"},{"type":"text","id":"success_text","label":"Success message","default":"Thanks for signing up."},{"type":"text","id":"disclaimer","label":"Consent note","default":"You can unsubscribe at any time. See our"}],"presets":[{"name":"Newsletter signup"}]}
{% endschema %}