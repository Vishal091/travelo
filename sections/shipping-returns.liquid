<section class="section-space shipping-returns-section"><div class="page-width">
  <div class="section-heading"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="section-intro rte">{{ section.settings.intro }}</div></div>
  <div class="policy-cards">
    <article class="policy-card"><span class="policy-icon" aria-hidden="true">↗</span><h3>Shipping & delivery</h3><p>Review destination coverage, shipping charges, order processing and the current delivery estimate before checkout.</p><a class="text-link" href="/policies/shipping-policy">Read shipping policy →</a></article>
    <article class="policy-card"><span class="policy-icon" aria-hidden="true">↺</span><h3>Returns & refunds</h3><p>See the return request window, eligibility requirements and how approved refunds are handled.</p><a class="text-link" href="/policies/refund-policy">Read returns policy →</a></article>
    <article class="policy-card"><span class="policy-icon" aria-hidden="true">✉</span><h3>Need help?</h3><p>Contact our team with your order number and a short description of the issue.</p><a class="text-link" href="/pages/contact">Contact support →</a></article>
  </div>
</div></section>
{% schema %}
{"name":"Shipping and returns","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Shop with clear information"},{"type":"text","id":"heading","label":"Heading","default":"Know what to expect."},{"type":"richtext","id":"intro","label":"Intro","default":"<p>Before launch, we will publish verified delivery estimates, return instructions and real support contact details. Check the policies linked below before placing an order.</p>"}],"presets":[{"name":"Shipping and returns"}]}
{% endschema %}