{% assign featured_product = section.settings.product %}
<section class="section-space featured-product-section"><div class="page-width"><div class="section-heading">{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.text != blank %}<div class="section-intro rte">{{ section.settings.text }}</div>{% endif %}</div>
{% if featured_product != blank %}<div class="featured-product-grid"><a class="featured-product-media" href="{{ featured_product.url }}">{% if featured_product.featured_image %}{{ featured_product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000', alt: featured_product.title }}{% else %}<div class="image-placeholder">Add product photography</div>{% endif %}</a><div class="featured-product-details"><p class="eyebrow">A practical little upgrade</p><h3><a href="{{ featured_product.url }}">{{ featured_product.title | escape }}</a></h3>{% render 'price', product: featured_product %}<p class="product-description">{{ section.settings.product_blurb | escape }}</p>{% form 'product', featured_product, class: 'product-form' %}{% if featured_product.variants.size > 1 %}<label for="FeaturedVariant-{{ section.id }}">Choose an option</label><select id="FeaturedVariant-{{ section.id }}" name="id">{% for variant in featured_product.variants %}<option value="{{ variant.id }}" {% if variant == featured_product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} · Sold out{% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ featured_product.selected_or_first_available_variant.id }}">{% endif %}<button class="button button-primary button-full" type="submit" name="add" {% unless featured_product.selected_or_first_available_variant.available %}disabled{% endunless %}>{% if featured_product.available %}Add to cart{% else %}Sold out{% endif %}</button>{% endform %}<p class="fine-print">Product details and delivery options are shown at checkout.</p></div></div>{% else %}<div class="editor-empty-state"><strong>Select a product to feature</strong><p>Open the theme editor and choose your shower hair catcher in this section's settings. Price, imagery and variants will come from Shopify Admin.</p><a class="text-link" href="{{ routes.all_products_collection_url }}">View all products</a></div>{% endif %}</div></section>
{% schema %}{"name":"Featured product","settings":[{"type":"product","id":"product","label":"Product"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The everyday favourite"},{"type":"text","id":"heading","label":"Heading","default":"Small fix. Smoother routine."},{"type":"richtext","id":"text","label":"Intro text","default":"<p>Discover simple helpers for everyday home routines.</p>"},{"type":"textarea","id":"product_blurb","label":"Short product description","default":"Helps collect loose hair near compatible shower drains for easier cleanup."}],"presets":[{"name":"Featured product"}]}{% endschema %}