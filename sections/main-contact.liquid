<section class="section-space contact-section"><div class="page-width contact-layout">
  <div class="contact-copy"><p class="eyebrow">We're here to help</p><h1>{{ section.settings.heading | escape }}</h1><div class="rte">{{ section.settings.intro }}</div><div class="contact-help"><strong>Order question?</strong><p>Include your order number and the email used at checkout. Do not send payment card details.</p><a href="/policies/shipping-policy">Shipping policy</a><a href="/policies/refund-policy">Returns & refunds</a></div></div>
  <div class="contact-form-wrap">
  {% form 'contact', id: 'ContactForm' %}
    {% if form.posted_successfully? %}<p class="form-success" role="status">{{ section.settings.success_message | escape }}</p>{% else %}
      {% if form.errors %}<div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      <div class="form-field"><label for="ContactName">Name</label><input id="ContactName" type="text" name="contact[name]" value="{{ form.name | escape }}" autocomplete="name" required></div>
      <div class="form-field"><label for="ContactEmail">Email</label><input id="ContactEmail" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" required></div>
      <div class="form-field"><label for="ContactOrder">Order number (optional)</label><input id="ContactOrder" type="text" name="contact[Order number]" autocomplete="off"></div>
      <div class="form-field"><label for="ContactBody">How can we help?</label><textarea id="ContactBody" name="contact[body]" rows="6" required>{{ form.body | escape }}</textarea></div>
      <button type="submit" class="button button-primary button-full">{{ section.settings.button_label | escape }}</button>
    {% endif %}
  {% endform %}
  </div>
</div></section>
{% schema %}
{"name":"Contact form","settings":[{"type":"text","id":"heading","label":"Heading","default":"Let's sort it out."},{"type":"richtext","id":"intro","label":"Intro","default":"<p>Questions about fit, shipping or an order? Send us a message using the form. A real monitored support email must be configured in Shopify before launch.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Send message"},{"type":"text","id":"success_message","label":"Success message","default":"Thanks for your message. We'll be in touch."}],"presets":[{"name":"Contact form"}]}
{% endschema %}