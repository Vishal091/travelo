<section class="hero-section"><div class="page-width hero-grid"><div class="hero-copy">{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h1>{{ section.settings.heading | escape | newline_to_br }}</h1>{% if section.settings.text != blank %}<div class="hero-description rte">{{ section.settings.text }}</div>{% endif %}<div class="hero-actions">{% if section.settings.primary_label != blank %}<a class="button button-primary" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}{% if section.settings.secondary_label != blank %}<a class="button button-secondary" href="{{ section.settings.secondary_link | default: routes.root_url }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}</div>{% if section.settings.note != blank %}<p class="sub-note">{{ section.settings.note | escape }}</p>{% endif %}</div><div class="hero-media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1400 | image_tag: class: 'hero-image', widths: '500,700,900,1200,1400', loading: 'eager', alt: section.settings.heading }}{% else %}<div class="hero-placeholder" role="img" aria-label="Tavelo Home product image placeholder"><span class="placeholder-kicker">TAVELO HOME · EVERYDAY ESSENTIALS</span><div class="drain-art"></div><p>Add your real product photo in the theme editor</p></div>{% endif %}{% if section.settings.badge != blank %}<div class="hero-badge"><span class="badge-dot"></span>{{ section.settings.badge | escape }}</div>{% endif %}</div></div></section>
{% schema %}{"name":"Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A little easier, every day"},{"type":"textarea","id":"heading","label":"Heading","default":"Less drain drama.\nMore easy mornings."},{"type":"richtext","id":"text","label":"Text","default":"<p>Practical home essentials for the little tasks that repeat.</p>"},{"type":"image_picker","id":"image","label":"Hero image"},{"type":"text","id":"badge","label":"Image badge","default":"Thoughtful everyday tools"},{"type":"text","id":"primary_label","label":"Primary button label","default":"Shop essentials"},{"type":"url","id":"primary_link","label":"Primary button link"},{"type":"text","id":"secondary_label","label":"Secondary button label","default":"Our approach"},{"type":"url","id":"secondary_link","label":"Secondary button link"},{"type":"text","id":"note","label":"Small note","default":"Useful by design. Simple by nature."}],"presets":[{"name":"Hero"}]}{% endschema %}