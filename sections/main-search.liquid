<section class="section-space search-section"><div class="page-width"><h1>Search</h1><form action="{{ routes.search_url }}" method="get" role="search" class="search-form"><label class="visually-hidden" for="SearchInput">Search products and pages</label><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products"><input type="hidden" name="options[prefix]" value="last"><button class="button button-primary" type="submit">Search</button></form>{% if search.performed %}<p class="search-summary">{{ search.results_count }} result(s) for “{{ search.terms | escape }}”</p>{% if search.results.size > 0 %}<div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'card-product', card_product: item %}{% else %}<article class="search-page-result"><h2><a href="{{ item.url }}">{{ item.title | escape }}</a></h2><p>{{ item.content | strip_html | truncate: 140 }}</p></article>{% endif %}{% endfor %}</div>{% endif %}{% endif %}</div></section>
{% schema %}{"name":"Search results","settings":[]}{% endschema %}