<section class="section-space rich-text-section" id="our-approach"><div class="page-width rich-text-inner">{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2>{{ section.settings.heading | escape }}</h2><div class="rte section-intro">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="button button-secondary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}</div></section>
{% schema %}{"name":"Rich text","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Our approach"},{"type":"text","id":"heading","label":"Heading","default":"Useful by design. Simple by nature."},{"type":"richtext","id":"text","label":"Text","default":"<p>We believe everyday products should be easy to understand, practical to use and honest about what they can do.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Shop all"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Rich text"}]}{% endschema %}