<header class="site-header"><div class="page-width header-inner">
<button class="icon-button menu-toggle" type="button" aria-expanded="false" aria-controls="SiteNav" data-menu-toggle aria-label="Open menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
<a class="site-brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">{% if settings.logo != blank %}{{ settings.logo | image_url: width: settings.logo_width | image_tag: class: 'site-logo', widths: '80,120,160,220', alt: settings.brand_name }}{% else %}<span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 14c3-1 4-5 8-5s5 4 8 3M4 18c3-1 4-5 8-5s5 4 8 3M12 3c1.5 2 2.3 3.1 2.3 4.2a2.3 2.3 0 1 1-4.6 0C9.7 6.1 10.5 5 12 3Z"/></svg></span><span>{{ settings.brand_name | default: shop.name | escape }}</span>{% endif %}</a>
<nav class="site-nav" id="SiteNav" data-site-nav aria-label="Main navigation">{% assign main_menu = section.settings.menu %}{% if main_menu != blank %}{% for link in main_menu.links %}<a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a>{% endfor %}{% else %}<a href="{{ routes.all_products_collection_url }}">Shop all</a><a href="{{ routes.root_url }}#our-approach">Our approach</a><a href="{{ routes.root_url }}#site-footer">Contact</a>{% endif %}</nav>
<a class="header-cart" href="{{ routes.cart_url }}" aria-label="Shopping cart, {{ cart.item_count }} items"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.1 10.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 8H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg><span class="cart-count">{{ cart.item_count }}</span></a>
</div></header>
{% schema %}{"name":"Header","settings":[{"type":"link_list","id":"menu","label":"Menu","default":"main-menu"}]}{% endschema %}